{
  "rules": {
    ".read": false,
    ".write": false,
    "analyses": { "$uid": {
      ".read": "auth != null && auth.uid === $uid",
      ".write": "auth != null && auth.uid === $uid"
    }},
    "notifications": { "$uid": {
      ".read": "auth != null && auth.uid === $uid",
      ".write": "auth != null && auth.uid === $uid"
    }},
    "blocked": { "$uid": {
      ".read": "auth != null && auth.uid === $uid",
      ".write": "auth != null && auth.uid === $uid"
    }},
    "reports": {
      ".read": "auth != null && auth.token.email === 'smriazul2002@gmail.com'",
      "$reportId": {
        ".write": "auth != null && ((!data.exists() && newData.child('reporterUid').val() === auth.uid) || auth.token.email === 'smriazul2002@gmail.com')"
      }
    }
  }
}
